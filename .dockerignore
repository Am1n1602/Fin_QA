# Keep the build context small -- these never need to reach a container image.
.git/
venv/
node_modules/
__pycache__/
*.pyc
*.egg-info/
archive/
data/
Claude outputs/
.claude/

# database/data/ and data_extraction/data/ are mounted as volumes at runtime for the
# local stack (see deployment/compose/docker-compose.yml), never baked into that image.
# The public demo image (api.public.Dockerfile) bakes in a small curated snapshot instead,
# from deployment/docker/public_data/ (built by deployment/scripts/build_public_dataset.py)
# -- a separate, much smaller path, not this one.
database/data/
data_extraction/data/

dashboard_v2/node_modules/
dashboard_v2/dist/

evaluation/reports/*.json
