# Copy to deployment/compose/.env (gitignored) and fill in real values.
# `docker compose` in this directory loads .env automatically.

# Required -- Grafana refuses to start without this (no insecure default password).
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# Required -- Postgres and MinIO refuse to start without these either (no insecure
# default passwords). Usernames/DB name default to "finqa" if left unset; the passwords
# do not.
POSTGRES_USER=finqa
POSTGRES_PASSWORD=
POSTGRES_DB=finqa
MINIO_ROOT_USER=finqa
MINIO_ROOT_PASSWORD=

# Optional -- only needed if you want /qa or /research to actually call an LLM.
GROQ_API_KEY=
ANTHROPIC_API_KEY=
