# Copy this file to .env (or set these as real environment variables in your
# shell / OS) and fill in your own key(s). Never commit the real .env file —
# it's already excluded in .gitignore.

# Required for the default cloud LLM path (free tier): https://console.groq.com
GROQ_API_KEY=your-groq-key-here

# Optional — only needed if you want the Anthropic/Claude cloud path instead
# of, or alongside, Groq. Install with: pip install -e ".[anthropic]"
ANTHROPIC_API_KEY=your-anthropic-key-here
